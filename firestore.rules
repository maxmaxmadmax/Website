rules_version = '2';

// SoundzGood vendor signup
//
// The important rule here: nothing a vendor can write decides whether a site
// is taken or whether they have paid. Site allocation and payment status are
// written only by Cloud Functions using the Admin SDK, which bypasses these
// rules. Vendors can read the map and write their own draft details, and that
// is all.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsDoc() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Events, sites and categories
    // Public read so the map and the category counts can be shown to
    // anyone. Written by admins or by Cloud Functions only.
    // ---------------------------------------------------------------
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      match /sites/{siteId} {
        // Never writable from a browser. Holds and bookings go through
        // the holdSite / releaseHold functions so they run in a
        // transaction and cannot double book.
        allow read: if true;
        allow write: if false;
      }

      match /categories/{categoryId} {
        // Counts are maintained server side in the same transaction that
        // allocates a site, so a limit cannot be beaten by two people
        // submitting at once.
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() &&
          // an admin may change the limit or the name, never the live count
          request.resource.data.count == resource.data.count;
      }
    }

    // ---------------------------------------------------------------
    // Bookings
    // A vendor may create and edit their own booking while it is still a
    // draft. Once it is pending payment or confirmed it is read only to
    // them - only Cloud Functions move it forward.
    // ---------------------------------------------------------------
    match /bookings/{bookingId} {

      allow read: if isAdmin() || ownsDoc();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.paymentStatus == 'none'
        // a vendor cannot invent a price, a site or a confirmation
        && !('amountCents' in request.resource.data)
        && !('siteId' in request.resource.data)
        && !('stripeSessionId' in request.resource.data)
        // nor an approval or a staff note - both are set by admins only
        && !('reviewStatus' in request.resource.data)
        && !('notes' in request.resource.data)
        && request.resource.data.vendorType in ['food', 'market'];

      //  UPDATE IS ABOUT WHAT CHANGED, NOT WHAT IS PRESENT
      //
      //  This used to demand that a draft not contain amountCents or
      //  siteId at all. That is right when the booking is first created,
      //  and wrong for every update afterwards: holdSite puts both of
      //  those on the document, and the vendor then fills in their
      //  details and documents, which saves the draft again. The merged
      //  document contains the fields the server just wrote, so the rule
      //  refused - and no vendor could ever reach the payment page.
      //
      //  What actually matters is that the vendor cannot CHANGE any of
      //  it. Everything the server owns has to come back untouched.
      //  Editing stays open until the money is actually taken.
      //
      //  It used to require status == 'draft', which locked a vendor out
      //  the moment they opened a checkout: go to Stripe, press back, fix
      //  a typo, and the save is refused until the session expires half an
      //  hour later - by which point they have given up. Nothing dangerous
      //  is possible while pending_payment, because status itself and
      //  everything else the server owns are locked below.
      allow update: if signedIn()
        && ownsDoc()
        && resource.data.status in ['draft', 'pending_payment']
        && resource.data.paymentStatus in ['none', 'unpaid']
        && request.resource.data.vendorType in ['food', 'market']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             // who they are, and where they are up to
             'uid', 'status', 'paymentStatus',
             // the money - set by holdSite, recomputed at checkout
             'amountCents', 'bookingFeeCents', 'gstCents', 'totalCents',
             'amountPaidCents', 'currency',
             // the site - allocated in a transaction, never chosen here
             'siteId', 'siteIds', 'siteLabel', 'siteType', 'holdExpiresAt',
             // payment and confirmation
             'stripeSessionId', 'stripePaymentIntentId', 'reference',
             'countedCategoryId', 'confirmedAt', 'cancelledAt', 'problem',
             // staff only - nobody approves themselves
             'reviewStatus', 'reviewedAt', 'reviewedBy', 'reviewReason',
             'notes', 'addedByAdmin', 'addedBy'
           ]);

      // Bookings are cancelled, never deleted, so there is an audit trail.
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // The gig guide
    //
    // Public read: it is a listing of what is on, and the whole point is
    // that anybody can see it. Never writable from a browser - every one
    // of these is written by the syncGigGuide function using the Admin
    // SDK, which bypasses these rules. A gig guide anybody could post
    // into would last about a week.
    // ---------------------------------------------------------------
    match /gigs/{gigId} {
      allow read: if true;
      allow write: if false;
    }

    match /gigGuide/{docId} {
      // status says when the guide last ran, so the page can show how
      // fresh it is. cache is 200KB of working state that no browser has
      // any use for, so it stays closed.
      allow read: if docId == 'status';
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Anything not named above is closed.
    // ---------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
